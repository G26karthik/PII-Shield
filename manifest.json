{
  "manifest_version": 3,
  "name": "PII Shield",
  "version": "2.0.0",
  "description": "Automatically detects and redacts personal information on any website. Uses free AI to create custom masking rules — no API key needed.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://text.pollinations.ai/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PII Shield Settings"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/pii-detectors.js", "content/content.js", "content/widget.js"],
      "css": ["content/widget.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/pii-detectors.js", "content/inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
